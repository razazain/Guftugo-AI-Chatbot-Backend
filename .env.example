# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# MongoDB Atlas: paste your Atlas connection string here
MONGODB_URI=
MONGODB_MAX_POOL_SIZE=20

# Generate independent random secrets (at least 32 characters each)
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Comma-separated frontend origins. In production, use your exact web app origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI provider selection: groq | gemini | openai
LLM_PROVIDER=groq
# Providers are attempted in order when the previous configured provider fails.
LLM_FALLBACK_PROVIDERS=gemini,openai
LLM_TIMEOUT_MS=120000
LLM_MAX_HISTORY_MESSAGES=30
LLM_MAX_CONTEXT_CHARS=20000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.7

# Optional web search integration (Tavily). Keep disabled until you configure a key.
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# Groq (primary by default)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback: Gemini uses Google's OpenAI-compatible API endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# API limits
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=30
MAX_JSON_BODY_SIZE=1mb
